<view class="page">
  <view class="hero row between">
    <view>
      <view class="eyebrow">深圳 · 私藏美食手帐</view>
      <view class="title">
        <view>把好吃的，</view>
        <view>圈进小地图。</view>
      </view>
      <view class="subtitle">下一顿快乐，就在附近 ♡</view>
    </view>
    <view class="hero-emoji">🍙</view>
  </view>
  <input
    class="input"
    placeholder="找店名、口味，或者那道念念不忘的菜"
    value="{{query}}"
    bindinput="search"
  />
  <scroll-view class="filters" scroll-x>
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="chip {{category===item?'active':''}}"
      data-value="{{item}}"
      bindtap="category"
    >
      {{item}}
    </view>
  </scroll-view>
  <view class="map-frame">
    <map
      id="food-map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="13"
      markers="{{markers}}"
      show-location
      bindmarkertap="marker"
      bindcallouttap="marker"
    />
  </view>
  <view class="row between">
    <view class="muted">
      📍 {{location?'跟随你的位置 · 直线距离':'深圳出发 · 等待定位'}}
    </view>
    <button class="small mint" bindtap="locate">定位到我</button>
  </view>
  <view wx:if="{{locationError}}" class="error" bindtap="permission">
    {{locationError}} · 点此设置
  </view>
  <view wx:if="{{offline}}" class="error">
    当前显示离线缓存，联网后下拉刷新
  </view>
  <view wx:if="{{error}}" class="error" bindtap="load">
    {{error}} · 点击重试
  </view>
  <view class="row between section">
    <text>我的好吃地图</text>
    <text class="muted">{{visible.length}} 家小确幸</text>
  </view>
  <view wx:if="{{loading}}" class="loading">正在翻开美食手帐…</view>
  <view
    wx:for="{{visible}}"
    wx:key="_id"
    class="card"
    data-id="{{item._id}}"
    bindtap="open"
  >
    <view class="row">
      <image
        wx:if="{{item.photos.length}}"
        class="cover"
        src="{{item.photos[0]}}"
        mode="aspectFill"
      />
      <view wx:else class="cover">🍜</view>
      <view class="grow">
        <view class="row between">
          <text class="name">{{item.name}}</text>
          <text class="badge">{{item.category}}</text>
        </view>
        <mood level="{{item.likeLevel}}" character="{{character}}" compact />
        <view class="muted">
          {{item.dishLabel || '还没记下招牌菜，下一次补上'}}
        </view>
      </view>
    </view>
    <view class="divider" />
    <view class="row between">
      <view>
        <view class="muted">📍 直线 {{item.distanceLabel}}</view>
        <view class="muted">{{item.routeLabel}}</view>
      </view>
      <text class="link">去翻翻记忆 →</text>
    </view>
  </view>
  <view wx:if="{{!loading &amp;&amp; !visible.length}}" class="card empty">
    <text class="empty-icon">🥟</text>
    <view class="section">
      {{records.length?'换个关键词试试':'第一口快乐，由你来记'}}
    </view>
    <view class="muted">
      {{records.length?'店名、口味、推荐菜都能搜到':'拍张照，写下那道让你想再来的菜。'}}
    </view>
    <button style="margin-top: 25rpx" bindtap="add">＋ 记一家好吃的</button>
  </view>
  <view class="footer-note">好好吃饭，也好好收藏生活。</view>
</view>
